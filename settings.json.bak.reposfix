{
  "settings_schema": 2,
  "crew_template": "zcp2o-maintainer",
  "repos": [
    "Ringga999/zcp2o-protocol",
    "Ringga999/notapeer-app",
    "https://github.com/Ringga999/zcp2o-protocol"
  ],
  "brains": {
    "WORKHORSE": [
      {
        "provider": "nvidia",
        "model": "deepseek-ai/deepseek-coder-6.7b-instruct"
      },
      {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3.5-lightning-30b-a3b"
      }
    ],
    "SPECIALIST": [
      {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3.5-lightning-30b-a3b"
      }
    ],
    "LIFELINE": [
      {
        "provider": "nvidia",
        "model": "nvidia/nemotron-3.5-lightning-30b-a3b"
      }
    ]
  },
  "agents": {
    "scout": {
      "enabled": true,
      "autonomous": true,
      "division": "Engineering",
      "brain": "WORKHORSE",
      "cadence_hours": 6,
      "template_role": "scout"
    },
    "triage": {
      "enabled": true,
      "autonomous": true,
      "division": "Engineering",
      "brain": "SPECIALIST",
      "cadence_hours": 6,
      "template_role": "triage"
    },
    "tester": {
      "enabled": true,
      "autonomous": true,
      "division": "Engineering",
      "brain": "WORKHORSE",
      "cadence_hours": 6,
      "template_role": "tester"
    },
    "sentinel": {
      "enabled": true,
      "autonomous": true,
      "role": "Operator",
      "division": "Security",
      "brain": "SPECIALIST",
      "cadence_hours": 6,
      "template_role": "sentinel"
    },
    "bridge": {
      "enabled": true,
      "autonomous": true,
      "division": "Security",
      "brain": "SPECIALIST",
      "cadence_hours": 12,
      "template_role": "bridge"
    },
    "scribe": {
      "enabled": true,
      "autonomous": true,
      "division": "Content",
      "brain": "WORKHORSE",
      "cadence_hours": 12,
      "template_role": "scribe"
    },
    "medic": {
      "enabled": true,
      "autonomous": true,
      "division": "Operations",
      "brain": "SPECIALIST",
      "cadence_hours": 12,
      "template_role": "medic"
    },
    "release": {
      "enabled": true,
      "autonomous": true,
      "division": "Operations",
      "brain": "WORKHORSE",
      "cadence_hours": 12,
      "template_role": "release"
    },
    "herald": {
      "enabled": true,
      "autonomous": true,
      "division": "Community",
      "brain": "WORKHORSE",
      "cadence_hours": 4,
      "template_role": "herald"
    },
    "diplomat": {
      "enabled": true,
      "autonomous": true,
      "role": "Operator",
      "division": "Community",
      "brain": "WORKHORSE",
      "cadence_hours": 4,
      "template_role": "diplomat"
    }
  },
  "limits": {
    "max_total_agents": 30,
    "max_per_provider": 10
  },
  "roles": {
    "Solver": {
      "capabilities": [
        "orchestrate",
        "solve",
        "supervise"
      ],
      "preferred_kinds": [
        "reasoning",
        "text",
        "vision"
      ],
      "tools": [
        "task-solving",
        "supervise",
        "simulate"
      ],
      "privileges": [
        "supervise"
      ]
    },
    "Architect": {
      "capabilities": [
        "structure-audit",
        "redesign"
      ],
      "preferred_kinds": [
        "reasoning",
        "coder"
      ],
      "tools": [
        "read-structure",
        "propose-change"
      ],
      "privileges": []
    },
    "Crafter": {
      "capabilities": [
        "code",
        "test"
      ],
      "preferred_kinds": [
        "coder"
      ],
      "tools": [
        "write-code",
        "run-tests"
      ],
      "privileges": []
    },
    "Analyst": {
      "capabilities": [
        "research",
        "synthesize"
      ],
      "preferred_kinds": [
        "text",
        "vision"
      ],
      "tools": [
        "read-web",
        "read-file",
        "produce-report"
      ],
      "privileges": []
    },
    "Communicator": {
      "capabilities": [
        "draft",
        "engage"
      ],
      "preferred_kinds": [
        "text"
      ],
      "tools": [
        "draft",
        "send-for-approval"
      ],
      "privileges": [
        "draft-first"
      ]
    },
    "Sentinel": {
      "capabilities": [
        "security",
        "dependency-audit"
      ],
      "preferred_kinds": [
        "coder",
        "reasoning"
      ],
      "tools": [
        "read-security",
        "flag-change"
      ],
      "privileges": []
    },
    "Operator": {
      "capabilities": [
        "routine",
        "handoff"
      ],
      "preferred_kinds": [
        "text",
        "coder"
      ],
      "tools": [
        "run-routine",
        "hand-off"
      ],
      "privileges": []
    }
  },
  "notifications": {
    "severity_filter": [
      "info",
      "warn",
      "crit"
    ],
    "quiet_hours_utc": null,
    "telegram_deliver_seconds": 10
  }
}